rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isBusinessOwner(businessId) {
      return isAuthenticated() && (
        (resource != null && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/businesses/$(businessId)) &&
         get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid)
      );
    }
    
    // Top-level biolinks
    match /biolinks/{linkId} {
      allow read: if true; // Public can see bio links
      allow write: if isAuthenticated() && (
        (resource == null && request.resource.data.businessId != null && 
          get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid) ||
        (resource != null && 
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid)
      );
    }

    match /users/{userId} {
      allow read, write: if isUser(userId);
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        (resource != null && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        (request.resource != null && 'ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) ||
        (resource == null)
      );
      allow delete: if isAuthenticated() && (
        resource == null ||
        !('ownerId' in resource.data) ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerId == 'guest_user'
      );

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    match /platform_pricing_plans/{planId} {
      allow read: if true;
      allow write: if true;
    }
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    match /platform_clients/{clientId} {
      allow read: if true;
      allow write: if true;
    }
    match /payment_transactions/{transactionId} {
      allow read: if true;
      allow write: if true;
    }
    match /admin_audit_logs/{logId} {
      allow read, write: if true;
    }
    match /platform_support_tickets/{ticketId} {
      allow read, write: if true;
    }
    match /platform_announcements/{announcementId} {
      allow read, write: if true;
    }
  }
}
