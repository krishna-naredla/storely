rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Security Helpers & Role Based Access Control (RBAC)
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAny(['admin', 'masterAdmin']) &&
          (request.auth.token.admin == true || request.auth.token.masterAdmin == true)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'maninaredla218@gmail.com' ||
          request.auth.token.email == 'admin@storelly.com' ||
          request.auth.token.email == 'superadmin@storelly.com' ||
          request.auth.token.email == 'localride369@gmail.com' ||
          request.auth.token.email.lower() == 'maninaredla218@gmail.com' ||
          request.auth.token.email.lower() == 'admin@storelly.com' ||
          request.auth.token.email.lower() == 'superadmin@storelly.com' ||
          request.auth.token.email.lower() == 'localride369@gmail.com'
        ))
      );
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && (
        isAdmin() ||
        (resource != null && 'ownerId' in resource.data && (
          resource.data.ownerId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.ownerId == request.auth.token.email)
        )) ||
        (request.resource != null && 'ownerId' in request.resource.data && (
          request.resource.data.ownerId == request.auth.uid ||
          (request.auth.token.email != null && request.resource.data.ownerId == request.auth.token.email)
        )) ||
        (exists(/databases/$(database)/documents/businesses/$(businessId)) && (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid ||
          (request.auth.token.email != null && (
            get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.token.email ||
            ('ownerEmail' in get(/databases/$(database)/documents/businesses/$(businessId)).data && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerEmail == request.auth.token.email) ||
            ('email' in get(/databases/$(database)/documents/businesses/$(businessId)).data && get(/databases/$(database)/documents/businesses/$(businessId)).data.email == request.auth.token.email)
          ))
        ))
      );
    }

    function isValidClientOrderCreate() {
      return (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus != 'paid' || (request.resource.data.total == 0)) &&
             (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'pending-verification', 'confirmed'] || (request.resource.data.total == 0 && request.resource.data.status == 'delivered'));
    }

    function isValidClientBookingCreate() {
      return (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus != 'paid' || (request.resource.data.totalPrice == 0)) &&
             (!('status' in request.resource.data) || (request.resource.data.status != 'completed' && request.resource.data.status != 'confirmed'));
    }

    // =========================================================================
    // User Profiles
    // =========================================================================
    match /users/{userId} {
      allow get: if isUser(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isUser(userId);
      allow update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Admins Registry
    // =========================================================================
    match /admins/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow write: if isAdmin();
    }

    // =========================================================================
    // Top-Level Public BioLinks
    // =========================================================================
    match /biolinks/{linkId} {
      allow read: if true;
      allow write: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.ownerId != null && request.resource.data.ownerId == request.auth.uid) ||
        (resource != null && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        (resource == null && request.resource.data.businessId != null && 
          exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)) &&
          get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid) ||
        (resource != null && 'businessId' in resource.data &&
          exists(/databases/$(database)/documents/businesses/$(resource.data.businessId)) &&
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid)
      );
    }

    // =========================================================================
    // Businesses & Multi-Tenant Entities
    // =========================================================================
    match /businesses/{businessId} {
      // Public storefront & merchant workspace can read/query business profiles
      allow read: if true;

      // Create: Authenticated user only, ownerId must equal auth.uid or email
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.ownerId == request.auth.uid ||
        (request.auth.token.email != null && (
          request.resource.data.ownerId == request.auth.token.email ||
          ('ownerEmail' in request.resource.data && request.resource.data.ownerEmail == request.auth.token.email) ||
          ('email' in request.resource.data && request.resource.data.email == request.auth.token.email)
        ))
      );

      // Update: Owner or Admin.
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (request.auth.token.email != null && (
          resource.data.ownerId == request.auth.token.email ||
          ('ownerEmail' in resource.data && resource.data.ownerEmail == request.auth.token.email) ||
          ('email' in resource.data && resource.data.email == request.auth.token.email)
        ))
      );

      // Delete: Owner or Admin only
      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (request.auth.token.email != null && (
          resource.data.ownerId == request.auth.token.email ||
          ('ownerEmail' in resource.data && resource.data.ownerEmail == request.auth.token.email) ||
          ('email' in resource.data && resource.data.email == request.auth.token.email)
        ))
      );

      // --- Public Showcase & Catalog Subcollections ---
      match /catalog/{itemId} {
        allow read: if true;
        allow create, delete: if isBusinessOwner(businessId);
        allow update: if isBusinessOwner(businessId) || 
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity', 'inStock', 'updatedAt']));
      }

      match /catalogue/{itemId} {
        allow read: if true;
        allow create, delete: if isBusinessOwner(businessId);
        allow update: if isBusinessOwner(businessId) || 
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity', 'inStock', 'updatedAt']));
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isBusinessOwner(businessId);
      }

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isBusinessOwner(businessId);
      }

      match /portfolio/{workId} {
        allow read: if true;
        allow write: if isBusinessOwner(businessId);
      }

      match /testimonials/{testimonialId} {
        allow read: if true;
        allow write: if isBusinessOwner(businessId);
      }

      match /offers/{offerId} {
        allow read: if true;
        allow write: if isBusinessOwner(businessId);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isBusinessOwner(businessId) || (
          (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'hidden']) &&
          (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
        );
        allow update, delete: if isBusinessOwner(businessId);
      }

      match /biolinks/{linkId} {
        allow read: if true;
        allow write: if isBusinessOwner(businessId);
      }

      // --- Affiliate & Recommended Products ---
      match /affiliate_products/{itemId} {
        allow read: if true;
        allow create, delete: if isBusinessOwner(businessId);
        allow update: if isBusinessOwner(businessId) || 
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'updatedAt']));
      }

      // --- Events & Ticketing Subcollections ---
      match /events/{eventId} {
        allow read: if true;
        allow create, delete: if isBusinessOwner(businessId);
        allow update: if isBusinessOwner(businessId) || 
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketsSold', 'seatsRemaining', 'status', 'updatedAt']));

        match /seat_holds/{holdId} {
          allow read, create: if true;
          allow update: if isBusinessOwner(businessId) || 
            (request.resource.data.status in ['completed', 'released', 'active']);
          allow delete: if isBusinessOwner(businessId);
        }
      }

      match /tickets/{ticketId} {
        allow list: if isBusinessOwner(businessId);
        allow get: if true;
        allow create: if request.resource.data.eventId is string &&
                         request.resource.data.customerName is string &&
                         request.resource.data.customerPhone is string &&
                         request.resource.data.ticketId is string &&
                         (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus != 'paid' || request.resource.data.price == 0);
        allow update, delete: if isBusinessOwner(businessId);
      }

      match /event_tickets/{ticketId} {
        allow list: if isBusinessOwner(businessId);
        allow get: if true;
        allow create: if request.resource.data.eventId is string &&
                         request.resource.data.customerName is string &&
                         request.resource.data.customerPhone is string &&
                         request.resource.data.ticketId is string &&
                         (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus != 'paid' || request.resource.data.price == 0);
        allow update, delete: if isBusinessOwner(businessId);
      }

      // --- Digital Products ---
      match /digital_products/{productId} {
        allow read, write: if isBusinessOwner(businessId);
      }

      // --- Orders & Transactional Collections ---
      match /orders/{orderId} {
        allow read, write: if isBusinessOwner(businessId);
        allow create: if isValidClientOrderCreate();
        allow get: if isBusinessOwner(businessId) || 
                      (isSignedIn() && resource.data.customerId == request.auth.uid);
      }

      match /bookings/{bookingId} {
        allow read, write: if isBusinessOwner(businessId);
        allow create: if isValidClientBookingCreate();
        allow get: if isBusinessOwner(businessId) || 
                      (isSignedIn() && resource.data.customerId == request.auth.uid);
      }

      match /slot_reservations/{slotId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isBusinessOwner(businessId) || 
                      (resource.data.status in ['pending', 'active'] && request.resource.data.status in ['cancelled', 'released']);
      }

      match /quote_requests/{quoteId} {
        allow read, write: if isBusinessOwner(businessId);
        allow create: if (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus != 'paid') &&
                         (!('status' in request.resource.data) || request.resource.data.status == 'new');
        allow get: if isBusinessOwner(businessId) || 
                      (isSignedIn() && resource.data.customerId == request.auth.uid);
      }

      match /quotes/{quoteId} {
        allow read, write: if isBusinessOwner(businessId);
        allow get: if isBusinessOwner(businessId) || 
                      (isSignedIn() && resource.data.customerId == request.auth.uid);
      }

      match /analyticsEvents/{eventId} {
        allow create: if request.resource.data.businessId == businessId &&
                         request.resource.data.eventType is string &&
                         request.resource.data.eventType.size() > 0 &&
                         request.resource.data.eventType.size() <= 60 &&
                         (!('revenue' in request.resource.data) || request.resource.data.revenue == 0) &&
                         (!('paymentStatus' in request.resource.data));
        allow read: if isBusinessOwner(businessId);
        allow update, delete: if false;
      }

      // --- Private Merchant Subcollections ---
      match /customers/{customerId} {
        allow read, write: if isBusinessOwner(businessId);
        allow create: if (request.resource.data.businessId == businessId) || isBusinessOwner(businessId);
      }

      match /notifications/{notificationId} {
        allow create: if isBusinessOwner(businessId);
        allow read, delete: if isBusinessOwner(businessId);
        allow update: if isBusinessOwner(businessId) &&
          request.resource.data.businessId == resource.data.businessId;
      }

      match /expenses/{expenseId} {
        allow read, write: if isBusinessOwner(businessId);
      }

      match /analytics/{docId} {
        allow read, write: if isBusinessOwner(businessId);
      }

      match /settings/{docId} {
        allow read, write: if isBusinessOwner(businessId);
      }

      match /payouts/{payoutId} {
        allow read, write: if isBusinessOwner(businessId);
      }
    }

    // =========================================================================
    // Platform Settings, Plans, and CMS Content
    // =========================================================================
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_pricing_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_clients/{clientId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /platform_support_tickets/{ticketId} {
      allow create: if true;
      allow read: if isAdmin() || (
        isSignedIn() && (
          (request.auth.token.email != null && resource.data.senderEmail == request.auth.token.email) ||
          ('businessId' in resource.data && isBusinessOwner(resource.data.businessId))
        )
      );
      allow update, delete: if isAdmin();
    }
  }
}
